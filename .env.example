DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
# En Railway: ${{RAILWAY_PUBLIC_DOMAIN}},healthcheck.railway.app
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Orígenes HTTPS completos, separados por coma. Vacío en local.
# En Railway: https://${{RAILWAY_PUBLIC_DOMAIN}}
DJANGO_CSRF_TRUSTED_ORIGINS=

POSTGRES_DB=vita_crm
POSTGRES_USER=vita
POSTGRES_PASSWORD=vita
# Hostname inside the Docker network. From the Mac, connect to localhost:5433.
POSTGRES_HOST=db
POSTGRES_PORT=5432
